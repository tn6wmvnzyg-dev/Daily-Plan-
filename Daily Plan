/**
 * 2. APP STATE & LOCALSTORAGE
 */
let state = {
  selectedDate: new Date(),
  plans: {},        // key: YYYY-MM-DD -> { blocks: [], dropped: [] }
  apiKey: localStorage.getItem('gemini_api_key') || '',
  theme: localStorage.getItem('app_theme') || 'dark'
};

function getIsoDate(d) {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}-${m}-${day}`;
}

function loadStorage() {
  const raw = localStorage.getItem('daily_planner_state_v1');
  if (raw) {
    try {
      const parsed = JSON.parse(raw);
      state.plans = parsed.plans || {};
    } catch (e) {
      console.error(e);
    }
  }
}

function saveStorage() {
  localStorage.setItem('daily_planner_state_v1', JSON.stringify({ plans: state.plans }));
}

function ensureDayPlan(dateStr) {
  if (!state.plans[dateStr]) {
    const d = new Date(dateStr + 'T12:00:00');
    const dow = d.getDay();
    const template = (WEEK_TEMPLATES[dow] || WEEK_TEMPLATES[1]).map(b => ({
      ...b,
      id: 'b_' + Math.random().toString(36).substr(2, 9),
      done: false
    }));
    state.plans[dateStr] = {
      blocks: JSON.parse(JSON.stringify(template)),
      dropped: []
    };
    saveStorage();
  }
  return state.plans[dateStr];
}

/**
 * 3. INTELLIGENTE UMPLANUNG (ALGORITHMUS)
 */
function rescheduleDay(dateStr) {
  const dayData = ensureDayPlan(dateStr);
  let blocks = dayData.blocks;

  // Trenne fixe Termine und variable Blöcke
  // Termine haben Kategorie TERMIN oder fixed:true (Schlaf, etc.)
  blocks.sort((a, b) => timeToMinutes(a.start) - timeToMinutes(b.start));

  const appointments = blocks.filter(b => b.category === CATEGORIES.TERMIN);
  let regularBlocks = blocks.filter(b => b.category !== CATEGORIES.TERMIN);

  if (appointments.length === 0) {
    render();
    return;
  }

  // Kollisionsauflösung gegen alle Termine (inkl. Fahrtzeiten)
  let resolvedBlocks = [];
  let droppedBlocks = [...dayData.dropped];

  // Prioritätsstufen für Streichung, falls > 22:00 (1320 Min.)
  // Unverrückbar: Trading, Sport, Essen, Termin, Schlafen
  const isProtected = (cat) => [CATEGORIES.TRADING, CATEGORIES.SPORT, CATEGORIES.ESSEN, CATEGORIES.TERMIN].includes(cat);

  for (let apt of appointments) {
    const aptStart = timeToMinutes(apt.start);
    const aptEnd = timeToMinutes(apt.end);

    let nextRegular = [];
    for (let blk of regularBlocks) {
      const bStart = timeToMinutes(blk.start);
      const bEnd = timeToMinutes(blk.end);

      // Keine Überlappung
      if (bEnd <= aptStart || bStart >= aptEnd) {
        nextRegular.push(blk);
        continue;
      }

      // Kollision! Block splitten oder verschieben
      const dur = bEnd - bStart;

      // Wenn Block lang genug (> 45 min) und vor Termin noch mind. 25 min Platz sind: Splitten
      if (aptStart - bStart >= 25 && dur >= 50) {
        // Teil 1 vor dem Termin
        nextRegular.push({
          ...blk,
          id: 'b_' + Math.random().toString(36).substr(2, 7),
          end: minutesToTime(aptStart)
        });
        // Teil 2 nach dem Termin verschoben
        const remainDur = dur - (aptStart - bStart);
        nextRegular.push({
          ...blk,
          id: 'b_' + Math.random().toString(36).substr(2, 7),
          start: minutesToTime(aptEnd),
          end: minutesToTime(aptEnd + remainDur)
        });
      } else {
        // Komplett hinter den Termin schieben
        nextRegular.push({
          ...blk,
          start: minutesToTime(aptEnd),
          end: minutesToTime(aptEnd + dur)
        });
      }
    }
    regularBlocks = nextRegular;
  }

  // Blöcke hintereinander glattziehen (Kettenverschiebung)
  // Alle Termine fixieren, Rest auffüllen
  let combined = [...appointments];
  regularBlocks.sort((a, b) => timeToMinutes(a.start) - timeToMinutes(b.start));

  let cursor = timeToMinutes("07:00");
  for (let blk of regularBlocks) {
    let dur = Math.max(15, timeToMinutes(blk.end) - timeToMinutes(blk.start));
    let blkStart = Math.max(cursor, timeToMinutes(blk.start));

    // Prüfe Kollision mit fixen Terminen
    for (let apt of appointments) {
      const aS = timeToMinutes(apt.start);
      const aE = timeToMinutes(apt.end);
      if (blkStart < aE && (blkStart + dur) > aS) {
        blkStart = aE; // nach hinten rücken
      }
    }

    let blkEnd = blkStart + dur;

    // Verdrängungs-Regel: Wenn Block über 22:00 Uhr rutscht
    if (blkEnd > timeToMinutes("22:00") && blk.title !== "Schlafen" && blk.category !== CATEGORIES.CARE) {
      if (!isProtected(blk.category)) {
        // Pause / Freizeit / Lesen / Selbstentwicklung fällt weg!
        droppedBlocks.push({
          ...blk,
          dropReason: "Wegen Terminverspätung nach 22:00 verdrängt"
        });
        continue; // wird nicht in Plan übernommen!
      } else {
        // Geschützt: Trading, Sport, Essen bleiben, werden ggf. vor 22:00 eingepasst
        blkStart = Math.min(blkStart, timeToMinutes("21:30"));
        blkEnd = blkStart + dur;
      }
    }

    cursor = blkEnd;
    combined.push({
      ...blk,
      start: minutesToTime(blkStart),
      end: minutesToTime(blkEnd)
    });
  }

  // Schlafen und Abendroutine fix am Ende garantieren
  combined.sort((a, b) => timeToMinutes(a.start) - timeToMinutes(b.start));
  dayData.blocks = combined;
  dayData.dropped = droppedBlocks;
  saveStorage();
  render();
}

/**
 * 4. TERMINPARSER (GEMINI API MIT ROBUSTEM OFFLINE-FALLBACK)
 */
async function processCommand(text) {
  const statusEl = document.getElementById('aiStatus');
  statusEl.textContent = 'Verarbeite Befehl...';

  // 1. Prüfen, ob Gemini API Key hinterlegt ist
  if (state.apiKey) {
    try {
      const res = await callGeminiApi(text);
      if (res) {
        applyParsedAction(res);
        statusEl.textContent = `Erfolgreich ausgeführt: "${res.title || res.action}"`;
        return;
      }
    } catch (e) {
      console.warn("Gemini Error, wechsel auf Offline-Parser", e);
    }
  }

  // 2. Offline-Regel-Parser (Funktioniert komplett ohne Key)
  const parsed = offlineParse(text);
  if (parsed) {
    applyParsedAction(parsed);
    statusEl.textContent = `Lokal ausgeführt: ${parsed.action} ${parsed.title || ''}`;
  } else {
    statusEl.textContent = 'Konnte Befehl nicht verstehen. Bsp: "Morgen 10 bis 11 Zahnarzt, 20 min Fahrt"';
  }
}

function offlineParse(str) {
  const lower = str.toLowerCase();
  const currentIso = getIsoDate(state.selectedDate);

  // Datum bestimmen (heute / morgen)
  let targetDate = new Date(state.selectedDate);
  if (lower.includes('morgen')) {
    targetDate.setDate(targetDate.getDate() + 1);
  }
  const dateStr = getIsoDate(targetDate);

  // Aktion: Auslassen / Löschen / Absagen
  if (lower.includes('kein ') || lower.includes('auslassen') || lower.includes('streichen')) {
    const match = lower.match(/(?:kein|keine|auslassen|streichen)\s+([a-zA-ZäöüÄÖÜß]+)/);
    const keyword = match ? match[1] : '';
    return { action: 'auslassen', keyword, date: dateStr };
  }

  if (lower.includes('absagen') || lower.includes('löschen') || lower.includes('entfernen')) {
    const match = lower.match(/([a-zA-ZäöüÄÖÜß]+)\s+(?:absagen|löschen|entfernen)/);
    const keyword = match ? match[1] : '';
    return { action: 'löschen', keyword, date: dateStr };
  }

  // Neuer Termin: Suche nach Zeit & Fahrtzeit
  // Bsp: "10 bis 11", "10:00 bis 11:30", "14 Uhr", "20 min Fahrt"
  const timeMatch = lower.match(/(\d{1,2})(?::(\d{2}))?\s*(?:bis|-|to)\s*(\d{1,2})(?::(\d{2}))?/);
  const travelMatch = lower.match(/(\d{1,2})\s*(?:min|minuten)\s*(?:fahrt|weg|anfahrt)/);

  if (timeMatch) {
    let startH = parseInt(timeMatch[1]);
    let startM = parseInt(timeMatch[2] || "0");
    let endH = parseInt(timeMatch[3]);
    let endM = parseInt(timeMatch[4] || "0");

    let travelMin = travelMatch ? parseInt(travelMatch[1]) : 0;

    // Titel extrahieren
    let title = str
      .replace(/morgen|heute/gi, '')
      .replace(/\d{1,2}(?::\d{2})?\s*(?:bis|-)\s*\d{1,2}(?::\d{2})?/gi, '')
      .replace(/\d{1,2}\s*(?:min|minuten)\s*(?:fahrt|weg|anfahrt)/gi, '')
      .replace(/,\s*/g, ' ')
      .trim();
    if (!title) title = "Termin";

    return {
      action: 'termin',
      date: dateStr,
      start: `${String(startH).padStart(2,'0')}:${String(startM).padStart(2,'0')}`,
      end: `${String(endH).padStart(2,'0')}:${String(endM).padStart(2,'0')}`,
      travelMinutes: travelMin,
      title: title
    };
  }

  return null;
}

async function callGeminiApi(userPrompt) {
  const selectedDateStr = getIsoDate(state.selectedDate);
  const prompt = `Du bist der Kalender-Assistent einer PWA. Heutiges Referenzdatum: ${selectedDateStr}.
Analysiere die Benutzeranfrage und antworte AUSSCHLIESSLICH mit einem validen JSON-Objekt ohne Markdown:
Mögliche Schemas:
1. Termin hinzufügen:
{"action":"termin", "date":"YYYY-MM-DD", "title":"...", "start":"HH:MM", "end":"HH:MM", "travelMinutes": 0}
2. Block auslassen:
{"action":"auslassen", "date":"YYYY-MM-DD", "keyword":"..."}
3. Termin löschen:
{"action":"löschen", "date":"YYYY-MM-DD", "keyword":"..."}

Eingabe: "${userPrompt}"`;

  const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent?key=${state.apiKey}`;
  const resp = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
  });
  const data = await resp.json();
  const rawText = data.candidates[0].content.parts[0].text.trim();
  const cleanJson = rawText.replace(/```json|```/g, '').trim();
  return JSON.parse(cleanJson);
}

function applyParsedAction(res) {
  const dayData = ensureDayPlan(res.date);

  if (res.action === 'termin') {
    let tStart = timeToMinutes(res.start);
    let tEnd = timeToMinutes(res.end);

    // Fahrtzeit vorher als Block hinzufügen
    if (res.travelMinutes && res.travelMinutes > 0) {
      const fahrtStart = tStart - res.travelMinutes;
      dayData.blocks.push({
        id: 'b_' + Math.random().toString(36).substr(2, 7),
        start: minutesToTime(Math.max(0, fahrtStart)),
        end: minutesToTime(tStart),
        title: `Fahrt zu ${res.title}`,
        category: CATEGORIES.PAUSE,
        fixed: true
      });
    }

    // Termin selbst
    dayData.blocks.push({
      id: 'b_' + Math.random().toString(36).substr(2, 7),
      start: minutesToTime(tStart),
      end: minutesToTime(tEnd),
      title: res.title,
      category: CATEGORIES.TERMIN,
      fixed: true
    });

    rescheduleDay(res.date);
    checkEarlyWakeup(res.date);

  } else if (res.action === 'auslassen') {
    const kw = res.keyword.toLowerCase();
    const idx = dayData.blocks.findIndex(b => b.title.toLowerCase().includes(kw) || b.category.toLowerCase().includes(kw));
    if (idx !== -1) {
      const removed = dayData.blocks.splice(idx, 1)[0];
      dayData.dropped.push({ ...removed, dropReason: 'Vom Nutzer ausgelassen' });
      saveStorage();
      rescheduleDay(res.date);
    }

  } else if (res.action === 'löschen') {
    const kw = res.keyword.toLowerCase();
    dayData.blocks = dayData.blocks.filter(b => !b.title.toLowerCase().includes(kw));
    dayData.dropped = dayData.dropped.filter(b => !b.title.toLowerCase().includes(kw));
    saveStorage();
    rescheduleDay(res.date);
  }
}

/**
 * 5. FRÜHER TERMIN & SCHLAFWARNUNG
 */
function checkEarlyWakeup(dateStr) {
  const dayData = ensureDayPlan(dateStr);
  const banner = document.getElementById('alertBanner');
  const title = document.getElementById('alertTitle');
  const desc = document.getElementById('alertDesc');

  // Suche nach dem frühesten Termin
  const terms = dayData.blocks.filter(b => b.category === CATEGORIES.TERMIN || b.title.startsWith('Fahrt'));
  if (terms.length === 0) {
    banner.classList.remove('show');
    return;
  }

  let earliestMinutes = 24 * 60;
  let earlyTerm = null;
  for (let t of terms) {
    const m = timeToMinutes(t.start);
    if (m < earliestMinutes) {
      earliestMinutes = m;
      earlyTerm = t;
    }
  }

  // Wenn der Termin vor 08:30 liegt, Wecker früher stellen (Morgenroutine mind. 40 Min Vorlauf)
  if (earliestMinutes < timeToMinutes("08:30")) {
    const wakeupMin = earliestMinutes - 45; // 45 Min Aufstehen, Waschen, Vorbereiten
    const wakeupTime = minutesToTime(wakeupMin);

    // Schlafzeit berechnen: Vorabend Schlafen war um 23:00 (1380 Min)
    // Schlafstunden = (24*60 - 23*60) + wakeupMin = 60 + wakeupMin
    const sleepDurationMin = 60 + wakeupMin;
    const sleepHours = (sleepDurationMin / 60).toFixed(1);

    banner.classList.add('show');
    title.innerHTML = `⏰ Wecker stellen auf ${wakeupTime} Uhr!`;

    if (sleepDurationMin < 8 * 60) {
      desc.innerHTML = `⚠️ <strong>Schlafwarnung:</strong> Nur ${sleepHours} Std. Schlaf (unter 8 Stunden)! Gehe am Vorabend früher schlafen oder plane Power-Nap ein.`;
    } else {
      desc.innerHTML = `Frühaufstehen für "${earlyTerm.title}". Schlafzeit: ${sleepHours} Std.`;
    }
  } else {
    banner.classList.remove('show');
  }
}

/**
 * 6. UI RENDERING & INTERAKTION
 */
function render() {
  const dateStr = getIsoDate(state.selectedDate);
  const dayData = ensureDayPlan(dateStr);

  // Datum & Header Text
  const options = { weekday: 'long', day: 'numeric', month: 'short' };
  document.getElementById('currentDateStr').textContent = state.selectedDate.toLocaleDateString('de-DE', options);
  document.getElementById('timelineTitle').textContent = `Zeitplan (${DOW_FULL[state.selectedDate.getDay()]})`;

  // Wochenleiste
  renderWeekBar();

  // Timeline Blöcke rendern
  const timelineEl = document.getElementById('timelineList');
  timelineEl.innerHTML = '';

  dayData.blocks.sort((a, b) => timeToMinutes(a.start) - timeToMinutes(b.start));

  const nowMin = new Date().getHours() * 60 + new Date().getMinutes();
  const isToday = getIsoDate(new Date()) === dateStr;

  dayData.blocks.forEach(block => {
    const bStart = timeToMinutes(block.start);
    const bEnd = timeToMinutes(block.end);
    const isCurrent = isToday && nowMin >= bStart && nowMin < bEnd;

    const card = document.createElement('div');
    card.className = `task-card ${block.done ? 'is-done' : ''} ${isCurrent ? 'is-current' : ''}`;

    card.innerHTML = `
      <div class="cat-indicator cat-${block.category}"></div>
      <div class="t-main" onclick="toggleTaskDone('${block.id}')">
        <div class="t-time">${block.start} – ${block.end}</div>
        <div class="t-name">${block.title}</div>
        <span class="t-badge cat-${block.category}">${block.category}</span>
      </div>
      <div class="t-actions">
        <button class="skip-btn" title="Auslassen" onclick="skipBlock('${block.id}')">✕</button>
        <button class="chk-btn ${block.done ? 'checked' : ''}" title="Abhaken" onclick="toggleTaskDone('${block.id}')">✓</button>
      </div>
    `;
    timelineEl.appendChild(card);
  });

  document.getElementById('blockCount').textContent = `${dayData.blocks.length} Blöcke`;

  // Heute nicht im Plan (Dropped / Skipped)
  const droppedSec = document.getElementById('droppedSection');
  const droppedList = document.getElementById('droppedList');
  droppedList.innerHTML = '';

  if (dayData.dropped && dayData.dropped.length > 0) {
    droppedSec.style.display = 'block';
    document.getElementById('droppedCount').textContent = dayData.dropped.length;

    dayData.dropped.forEach((drop, idx) => {
      const item = document.createElement('div');
      item.className = 'dropped-item';
      item.innerHTML = `
        <div>
          <strong>${drop.title}</strong>
          <div style="font-size:0.75rem; color:var(--text-muted);">${drop.dropReason || 'Ausgelassen'}</div>
        </div>
        <button class="restore-btn" onclick="restoreBlock(${idx})">Zurückholen</button>
      `;
      droppedList.appendChild(item);
    });
  } else {
    droppedSec.style.display = 'none';
  }

  updateNowCard();
  checkEarlyWakeup(dateStr);
}

function renderWeekBar() {
  const bar = document.getElementById('weekBar');
  bar.innerHTML = '';

  // Berechne Montag der aktuellen Woche
  const current = new Date(state.selectedDate);
  const dayOfWeek = current.getDay();
  const diffToMonday = (dayOfWeek + 6) % 7;
  const monday = new Date(current);
  monday.setDate(current.getDate() - diffToMonday);

  for (let i = 0; i < 7; i++) {
    const d = new Date(monday);
    d.setDate(monday.getDate() + i);

    const pill = document.createElement('div');
    const isSelected = getIsoDate(d) === getIsoDate(state.selectedDate);
    pill.className = `day-pill ${isSelected ? 'active' : ''}`;

    const dowIndex = d.getDay();
    pill.innerHTML = `
      <span class="dow">${DOW_NAMES[dowIndex]}</span>
      <span class="dom">${d.getDate()}</span>
    `;

    pill.onclick = () => {
      state.selectedDate = d;
      render();
    };

    bar.appendChild(pill);
  }
}

function updateNowCard() {
  const dateStr = getIsoDate(state.selectedDate);
  const dayData = ensureDayPlan(dateStr);
  const now = new Date();
  const isToday = getIsoDate(now) === dateStr;
  const nowMinutes = now.getHours() * 60 + now.getMinutes();

  if (!isToday) {
    document.getElementById('nowTitle').textContent = `Vorschau: ${DOW_FULL[state.selectedDate.getDay()]}`;
    document.getElementById('nowTimes').textContent = "Ganztägige Ansicht";
    document.getElementById('nowCountdown').textContent = "Inaktiv";
    document.getElementById('nextTitle').textContent = dayData.blocks[0] ? dayData.blocks[0].title : "--";
    return;
  }

  let currentBlock = null;
  let nextBlock = null;

  for (let i = 0; i < dayData.blocks.length; i++) {
    const b = dayData.blocks[i];
    const s = timeToMinutes(b.start);
    const e = timeToMinutes(b.end);

    if (nowMinutes >= s && nowMinutes < e) {
      currentBlock = b;
      nextBlock = dayData.blocks[i + 1] || null;
      break;
    }
  }

  if (currentBlock) {
    document.getElementById('nowTitle').textContent = currentBlock.title;
    document.getElementById('nowTimes').textContent = `${currentBlock.start} – ${currentBlock.end}`;
    const remain = timeToMinutes(currentBlock.end) - nowMinutes;
    document.getElementById('nowCountdown').textContent = `noch ${remain} Min.`;
    document.getElementById('nextTitle').textContent = nextBlock ? `${nextBlock.title} (${nextBlock.start})` : "Schlafen / Feierabend";
  } else {
    // Suche nächsten anstehenden Block heute
    const upcoming = dayData.blocks.filter(b => timeToMinutes(b.start) > nowMinutes);
    if (upcoming.length > 0) {
      document.getElementById('nowTitle').textContent = "Pause / Freizeit";
      document.getElementById('nowTimes').textContent = `bis ${upcoming[0].start}`;
      const diff = timeToMinutes(upcoming[0].start) - nowMinutes;
      document.getElementById('nowCountdown').textContent = `in ${diff} Min. geht's weiter`;
      document.getElementById('nextTitle').textContent = `${upcoming[0].title} (${upcoming[0].start})`;
    } else {
      document.getElementById('nowTitle').textContent = "Schlafenszeit / Tag beendet";
      document.getElementById('nowTimes').textContent = "23:00 – 07:00";
      document.getElementById('nowCountdown').textContent = "Erholung";
      document.getElementById('nextTitle').textContent = "Gute Nacht!";
    }
  }
}

// Block Aktionen
function toggleTaskDone(id) {
  const dayData = ensureDayPlan(getIsoDate(state.selectedDate));
  const b = dayData.blocks.find(x => x.id === id);
  if (b) {
    b.done = !b.done;
    saveStorage();
    render();
  }
}

function skipBlock(id) {
  const dayData = ensureDayPlan(getIsoDate(state.selectedDate));
  const idx = dayData.blocks.findIndex(x => x.id === id);
  if (idx !== -1) {
    const removed = dayData.blocks.splice(idx, 1)[0];
    dayData.dropped.push({ ...removed, dropReason: 'Manuell ausgelassen' });
    saveStorage();
    render();
  }
}

function restoreBlock(dropIdx) {
  const dayData = ensureDayPlan(getIsoDate(state.selectedDate));
  const item = dayData.dropped.splice(dropIdx, 1)[0];
  delete item.dropReason;
  dayData.blocks.push(item);
  saveStorage();
  rescheduleDay(getIsoDate(state.selectedDate));
}

function fillExample(txt) {
  document.getElementById('aiInput').value = txt;
}

// Formular-Submit
function handleAiSubmit(e) {
  e.preventDefault();
  const inp = document.getElementById('aiInput');
  const txt = inp.value.trim();
  if (txt) {
    processCommand(txt);
    inp.value = '';
  }
}

/**
 * 7. SPRACHEINGABE (WEB SPEECH API)
 */
const micBtn = document.getElementById('micBtn');
if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  const recognition = new SpeechRecognition();
  recognition.lang = 'de-DE';
  recognition.continuous = false;

  micBtn.onclick = () => {
    micBtn.classList.add('listening');
    document.getElementById('aiStatus').textContent = 'Höre zu... Sprich jetzt!';
    recognition.start();
  };

  recognition.onresult = (evt) => {
    const transcript = evt.results[0][0].transcript;
    document.getElementById('aiInput').value = transcript;
    micBtn.classList.remove('listening');
    processCommand(transcript);
  };

  recognition.onerror = () => {
    micBtn.classList.remove('listening');
    document.getElementById('aiStatus').textContent = 'Sprachfehler. Bitte tippen.';
  };

  recognition.onend = () => {
    micBtn.classList.remove('listening');
  };
} else {
  micBtn.style.display = 'none';
}

/**
 * 8. THEME & SETTINGS
 */
function applyTheme(theme) {
  state.theme = theme;
  localStorage.setItem('app_theme', theme);
  if (theme === 'light') {
    document.body.classList.add('light');
    document.getElementById('theme-color-meta').setAttribute('content', '#f8fafc');
  } else {
    document.body.classList.remove('light');
    document.getElementById('theme-color-meta').setAttribute('content', '#0f172a');
  }
}

document.getElementById('themeToggle').onclick = () => {
  applyTheme(state.theme === 'light' ? 'dark' : 'light');
};

function toggleSettings(show) {
  const modal = document.getElementById('settingsModal');
  if (show) {
    document.getElementById('apiKeyInput').value = state.apiKey;
    modal.classList.add('show');
  } else {
    modal.classList.remove('show');
  }
}
document.getElementById('settingsBtn').onclick = () => toggleSettings(true);

function saveSettings() {
  const key = document.getElementById('apiKeyInput').value.trim();
  state.apiKey = key;
  localStorage.setItem('gemini_api_key', key);
  toggleSettings(false);
  alert('Einstellungen gespeichert!');
}

function resetCurrentDay() {
  if (confirm("Möchtest du diesen Tag auf die Wochenvorlage zurücksetzen?")) {
    const dateStr = getIsoDate(state.selectedDate);
    delete state.plans[dateStr];
    ensureDayPlan(dateStr);
    toggleSettings(false);
    render();
  }
}

function resetAllDefaults() {
  if (confirm("Wirklich die gesamte Woche löschen und Vorlagen neu laden?")) {
    localStorage.removeItem('daily_planner_state_v1');
    state.plans = {};
    ensureDayPlan(getIsoDate(state.selectedDate));
    toggleSettings(false);
    render();
  }
}

// Live-Ticker für Countdown & "Jetzt"-Karte (jede Sekunde)
setInterval(() => {
  updateNowCard();
}, 1000);

// Initiale Ausführung
loadStorage();
applyTheme(state.theme);
render();

// Service Worker Registration für vollständige PWA-Offline-Nutzung
if ('serviceWorker' in navigator) {
  const swScript = `
    self.addEventListener('install', e => self.skipWaiting());
    self.addEventListener('activate', e => clients.claim());
    self.addEventListener('fetch', e => e.respondWith(fetch(e.request).catch(() => caches.match(e.request))));
  `;
  const blob = new Blob([swScript], { type: 'application/javascript' });
  navigator.serviceWorker.register(URL.createObjectURL(blob)).catch(() => {});
}
</script>
