<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Tagesplan PWA</title>

  <!-- PWA Meta Tags & iOS Standalone -->
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Tagesplan">
  <meta name="theme-color" content="#0f172a" id="theme-color-meta">

  <!-- Manifest als Data-URI -->
  <link rel="manifest" href="data:application/manifest+json;utf-8,%7B%22name%22%3A%22Tagesplan%22%2C%22short_name%22%3A%22Tagesplan%22%2C%22start_url%22%3A%22.%22%2C%22display%22%3A%22standalone%22%2C%22background_color%22%3A%22%230f172a%22%2C%22theme_color%22%3A%22%230f172a%22%7D">

  <style>
    :root {
      --bg: #0f172a;
      --surface: #1e293b;
      --surface-card: #273549;
      --border: #334155;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --accent: #38bdf8;
      --accent-glow: rgba(56, 189, 248, 0.15);
      --danger: #f43f5e;
      --warning: #f59e0b;
      --success: #10b981;
      --radius: 18px;
      --safe-top: env(safe-area-inset-top, 20px);
      --safe-bottom: env(safe-area-inset-bottom, 20px);
    }

    body.light {
      --bg: #f8fafc;
      --surface: #ffffff;
      --surface-card: #f1f5f9;
      --border: #e2e8f0;
      --text: #0f172a;
      --text-muted: #64748b;
      --accent: #0284c7;
      --accent-glow: rgba(2, 132, 199, 0.1);
    }

    /* Kategorie-Farben */
    .cat-Trading { background: #059669; color: #fff; }
    .cat-Sport { background: #d97706; color: #fff; }
    .cat-Brand { background: #7c3aed; color: #fff; }
    .cat-Lesen { background: #0284c7; color: #fff; }
    .cat-Selbstentwicklung { background: #4f46e5; color: #fff; }
    .cat-Meditation { background: #0d9488; color: #fff; }
    .cat-Essen { background: #e11d48; color: #fff; }
    .cat-SelfCare { background: #db2777; color: #fff; }
    .cat-Termin { background: #b91c1c; color: #fff; }
    .cat-Pause { background: #475569; color: #fff; }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; -webkit-tap-highlight-color: transparent; }
    body { background-color: var(--bg); color: var(--text); min-height: 100vh; padding-top: var(--safe-top); padding-bottom: calc(var(--safe-bottom) + 30px); transition: background-color 0.25s, color 0.25s; overflow-x: hidden; }
    .container { max-width: 480px; margin: 0 auto; padding: 12px 16px; }

    /* Header */
    header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
    h1 { font-size: 1.35rem; font-weight: 800; letter-spacing: -0.5px; }
    .header-btns { display: flex; gap: 8px; }
    .icon-btn { background: var(--surface); border: 1px solid var(--border); color: var(--text); width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; cursor: pointer; transition: transform 0.1s active; }
    .icon-btn:active { transform: scale(0.92); }

    /* Wochenleiste */
    .week-bar { display: flex; justify-content: space-between; background: var(--surface); padding: 6px; border-radius: var(--radius); border: 1px solid var(--border); margin-bottom: 16px; gap: 4px; }
    .day-pill { flex: 1; text-align: center; padding: 8px 2px; border-radius: 12px; cursor: pointer; transition: all 0.2s; }
    .day-pill.active { background: var(--accent); color: #fff; font-weight: bold; box-shadow: 0 4px 12px var(--accent-glow); }
    .day-pill .dow { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px; display: block; opacity: 0.8; }
    .day-pill.active .dow { opacity: 1; }
    .day-pill .dom { font-size: 0.95rem; font-weight: 700; display: block; margin-top: 2px; }

    /* Banner für Wecker / Schlaf */
    .alert-banner { background: linear-gradient(135deg, rgba(245, 158, 11, 0.18), rgba(220, 38, 38, 0.18)); border: 1px solid var(--warning); border-radius: var(--radius); padding: 12px 16px; margin-bottom: 16px; display: none; }
    .alert-banner.show { display: block; animation: slideDown 0.3s ease; }
    .alert-banner .title { font-weight: 700; font-size: 0.95rem; display: flex; align-items: center; gap: 6px; color: #fbbf24; }
    .alert-banner .desc { font-size: 0.82rem; margin-top: 4px; color: var(--text); opacity: 0.9; line-height: 1.35; }

    /* "Jetzt" Karte */
    .now-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; margin-bottom: 16px; position: relative; overflow: hidden; box-shadow: 0 8px 24px rgba(0,0,0,0.12); }
    .now-card::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 6px; background: var(--accent); }
    .now-tag { font-size: 0.7rem; text-transform: uppercase; font-weight: 800; letter-spacing: 1px; color: var(--accent); }
    .now-title { font-size: 1.3rem; font-weight: 800; margin: 4px 0 6px 0; }
    .now-time-row { display: flex; justify-content: space-between; align-items: center; font-size: 0.88rem; color: var(--text-muted); }
    .countdown-badge { background: var(--accent-glow); color: var(--accent); font-weight: 700; padding: 4px 10px; border-radius: 20px; font-size: 0.82rem; }
    .next-preview { margin-top: 12px; padding-top: 10px; border-top: 1px dashed var(--border); font-size: 0.82rem; color: var(--text-muted); display: flex; justify-content: space-between; }
    .next-preview strong { color: var(--text); }

    /* Eingabefeld Termin ansagen */
    .ai-box { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 12px; margin-bottom: 18px; }
    .ai-box-title { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; }
    .ai-form { display: flex; gap: 8px; }
    .ai-input { flex: 1; background: var(--surface-card); border: 1px solid var(--border); border-radius: 12px; padding: 10px 14px; color: var(--text); font-size: 0.9rem; outline: none; }
    .ai-input:focus { border-color: var(--accent); }
    .ai-btn { background: var(--accent); color: #fff; border: none; border-radius: 12px; padding: 0 14px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .mic-btn { background: var(--surface-card); border: 1px solid var(--border); color: var(--text); border-radius: 12px; width: 42px; display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .mic-btn.listening { background: var(--danger); color: white; animation: pulse 1s infinite; }
    .ai-status { font-size: 0.75rem; margin-top: 6px; color: var(--text-muted); min-height: 16px; }

    /* Timeline */
    .section-head { font-size: 0.9rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
    .timeline { display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px; }
    .task-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 12px 14px; display: flex; align-items: center; gap: 12px; transition: transform 0.15s, opacity 0.2s; position: relative; }
    .task-card.is-current { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-glow); }
    .task-card.is-done { opacity: 0.5; }
    .task-card.is-done .t-name { text-decoration: line-through; }
    .cat-indicator { width: 4px; height: 38px; border-radius: 4px; flex-shrink: 0; }
    .t-main { flex: 1; min-width: 0; }
    .t-time { font-size: 0.78rem; font-weight: 700; color: var(--text-muted); }
    .t-name { font-size: 0.96rem; font-weight: 700; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .t-badge { font-size: 0.65rem; font-weight: 700; padding: 2px 7px; border-radius: 10px; display: inline-block; margin-top: 4px; text-transform: uppercase; }
    .t-actions { display: flex; align-items: center; gap: 6px; }
    .chk-btn, .skip-btn { background: var(--surface-card); border: 1px solid var(--border); width: 34px; height: 34px; border-radius: 10px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--text-muted); font-size: 0.95rem; }
    .chk-btn.checked { background: var(--success); color: white; border-color: var(--success); }

    /* Heute nicht im Plan (Dropped / Skipped) */
    .dropped-section { background: rgba(244, 63, 94, 0.08); border: 1px dashed rgba(244, 63, 94, 0.3); border-radius: var(--radius); padding: 14px; margin-bottom: 24px; }
    .dropped-list { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }
    .dropped-item { display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; padding: 8px 10px; background: var(--surface); border-radius: 10px; border: 1px solid var(--border); }
    .restore-btn { background: var(--surface-card); border: 1px solid var(--border); padding: 4px 10px; border-radius: 8px; color: var(--accent); font-size: 0.78rem; font-weight: 700; cursor: pointer; }

    /* Modal für Settings & API Key */
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); display: none; align-items: flex-end; justify-content: center; z-index: 100; }
    .modal-overlay.show { display: flex; }
    .modal-content { background: var(--surface); border-top-left-radius: 24px; border-top-right-radius: 24px; width: 100%; max-width: 480px; padding: 20px; border: 1px solid var(--border); max-height: 85vh; overflow-y: auto; }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .modal-title { font-size: 1.15rem; font-weight: 800; }
    .close-btn { background: none; border: none; font-size: 1.4rem; color: var(--text-muted); cursor: pointer; }
    .form-group { margin-bottom: 14px; }
    .form-group label { display: block; font-size: 0.82rem; font-weight: 700; margin-bottom: 6px; color: var(--text-muted); }
    .form-input { width: 100%; background: var(--surface-card); border: 1px solid var(--border); border-radius: 12px; padding: 10px 12px; color: var(--text); font-size: 0.9rem; }
    .btn-full { width: 100%; padding: 12px; background: var(--accent); color: white; border: none; border-radius: 12px; font-weight: 700; cursor: pointer; margin-top: 10px; }
    .btn-secondary { width: 100%; padding: 10px; background: transparent; border: 1px solid var(--border); color: var(--text); border-radius: 12px; font-weight: 600; cursor: pointer; margin-top: 8px; }

    @keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.08); } 100% { transform: scale(1); } }
    @keyframes slideDown { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
  </style>
</head>
<body>

<div class="container">
  <!-- Header -->
  <header>
    <div>
      <div style="font-size:0.75rem; text-transform:uppercase; font-weight:700; color:var(--accent);" id="currentDateStr">Mittwoch, 21. Okt</div>
      <h1>Tagesplan</h1>
    </div>
    <div class="header-btns">
      <button class="icon-btn" id="themeToggle" title="Design wechseln">🌓</button>
      <button class="icon-btn" id="settingsBtn" title="Einstellungen">⚙️</button>
    </div>
  </header>

  <!-- Wochenleiste (Mo–So) -->
  <nav class="week-bar" id="weekBar" aria-label="Wochentag auswählen"></nav>

  <!-- Wecker- / Schlafwarnung Banner -->
  <div class="alert-banner" id="alertBanner">
    <div class="title" id="alertTitle">⏰ Wecker-Hinweis</div>
    <div class="desc" id="alertDesc">Früher Termin erfordert Wecker um 06:15 Uhr.</div>
  </div>

  <!-- "Jetzt" Karte -->
  <section class="now-card" id="nowCard">
    <div class="now-tag">Aktuell am Laufen</div>
    <div class="now-title" id="nowTitle">Freizeit & Erholung</div>
    <div class="now-time-row">
      <span id="nowTimes">--:-- – --:--</span>
      <span class="countdown-badge" id="nowCountdown">-- Min. übrig</span>
    </div>
    <div class="next-preview">
      <span>Nächster Block:</span>
      <strong id="nextTitle">--</strong>
    </div>
  </section>

  <!-- Termin ansagen (Gemini API + Lokaler intelligenter Parser) -->
  <section class="ai-box">
    <div class="ai-box-title">
      <span>🎙️ Termin ansagen / Plan ändern</span>
      <span style="font-size:0.7rem; color:var(--accent); cursor:pointer;" onclick="fillExample('Morgen 10 bis 11 Zahnarzt, 20 min Fahrt')">Beispiel 1</span>
    </div>
    <form class="ai-form" id="aiForm" onsubmit="handleAiSubmit(event)">
      <button type="button" class="mic-btn" id="micBtn" title="Spracheingabe">🎤</button>
      <input type="text" class="ai-input" id="aiInput" placeholder="z. B. 'Morgen 10 bis 11 Zahnarzt, 20 min Fahrt' oder 'heute kein Gym'" autocomplete="off" />
      <button type="submit" class="ai-btn" id="aiSubmitBtn">Senden</button>
    </form>
    <div class="ai-status" id="aiStatus"></div>
  </section>

  <!-- Tageszeitleiste -->
  <div class="section-head">
    <span id="timelineTitle">Zeitplan</span>
    <span style="font-size: 0.75rem; font-weight: normal;" id="blockCount">0 Blöcke</span>
  </div>
  <main class="timeline" id="timelineList"></main>

  <!-- Heute nicht im Plan (Dropped / Skipped) -->
  <section class="dropped-section" id="droppedSection" style="display:none;">
    <div style="font-size:0.82rem; font-weight:800; color:var(--danger); display:flex; justify-content:space-between;">
      <span>🚫 HEUTE NICHT IM PLAN (VERDRÄNGT / AUSGELASSEN)</span>
      <span id="droppedCount">0</span>
    </div>
    <div class="dropped-list" id="droppedList"></div>
  </section>
</div>

<!-- Modal für Einstellungen -->
<div class="modal-overlay" id="settingsModal">
  <div class="modal-content">
    <div class="modal-header">
      <div class="modal-title">⚙️ Einstellungen</div>
      <button class="close-btn" onclick="toggleSettings(false)">×</button>
    </div>
    <div class="form-group">
      <label for="apiKeyInput">Gemini API Key (Optional)</label>
      <input type="password" id="apiKeyInput" class="form-input" placeholder="AIzaSy..." />
      <p style="font-size:0.75rem; color:var(--text-muted); margin-top:4px;">
        Ist ein Key hinterlegt, verarbeitet Google Gemini jeden Freitext präzise als JSON. Ohne Key nutzt die App den integrierten lokalen Offline-Parser.
      </p>
    </div>
    <button class="btn-full" onclick="saveSettings()">Einstellungen speichern</button>
    <button class="btn-secondary" onclick="resetCurrentDay()">Diesen Tag auf Vorlage zurücksetzen</button>
    <button class="btn-secondary" onclick="resetAllDefaults()" style="color:var(--danger);">Gesamte Woche auf Werkseinstellung</button>
  </div>
</div>

